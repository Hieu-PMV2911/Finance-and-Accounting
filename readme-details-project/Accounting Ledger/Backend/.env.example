# ---- App ----
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=accounting_ledger
DB_LOGGING=false

# ---- Redis (BullMQ queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_REFRESH_EXPIRES_IN=7d

# ---- Bootstrap admin (dùng cho `pnpm seed`) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ---- Xử lý bất đồng bộ (mục 9) ----
# Tắt toàn bộ cron nếu muốn (mặc định bật). Jobs xếp tay qua API vẫn chạy.
JOBS_SCHEDULER_ENABLED=true
# Thư mục lưu file báo cáo do job `generate-report` sinh ra (mặc định ./storage/reports)
REPORT_STORAGE_DIR=
# Khóa ký HMAC cho webhook NHẬN VÀO (bỏ trống = không kiểm tra chữ ký, chỉ dùng khi dev)
WEBHOOK_INBOUND_SECRET=

# ---- Thanh toán qua provider (mục 10.B) ----
# `simulator` CHỈ dùng ở dev: lần gọi đầu cố tình timeout, lần tra cứu sau báo "đã thu tiền".
# `disabled` (mặc định): chưa nối provider thật — mọi giao dịch ở "chưa xác định" rồi leo thang,
#   hệ thống không bao giờ tự bịa ra kết quả thanh toán.
PAYMENT_PROVIDER=disabled
# Số lần tra cứu provider tối đa trước khi leo thang cho người ghi sổ (cron 2 phút/lần).
PAYMENT_INTENT_MAX_POLLS=5
# Số ngày cho phép lệch ở tầng khớp 2 (số tiền + ngày gần nhau) của đối soát sao kê.
RECONCILIATION_DATE_TOLERANCE_DAYS=3
